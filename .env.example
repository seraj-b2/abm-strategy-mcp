# Server Configuration (Backend API URL for MCP Token verification)
BACKEND_URL=http://localhost:5000

# Public URL of the OAuth authorization server (abm-strategy-backend),
# advertised to MCP clients via /.well-known/oauth-protected-resource.
# Must be reachable from the internet, e.g. https://mcp.seraj.live/api
OAUTH_AUTHORIZATION_SERVER_URL=

# Transport type: stdio or sse
TRANSPORT=sse

# Port for SSE transport
PORT=3000

# Skip authentication check (true/false)
SKIP_AUTH=false
